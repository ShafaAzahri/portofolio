generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  imageUrl    String
  techStack   String   // comma separated values or tags
  demoLink    String?
  githubLink  String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certification {
  id        String   @id @default(uuid())
  title     String
  issuer    String
  date      String
  icon      String
  imageUrl  String
  link      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id               Int      @id @default(1)
  name             String
  headline         String
  shortBio         String   @db.Text
  email            String
  linkedinUrl      String?
  githubUrl        String?
  
  heroTerminal1    String
  heroTerminal2    String
  heroTerminal3    String

  aboutTitle       String
  aboutDescription String   @db.Text
  location         String
  focus            String
  
  updatedAt        DateTime @updatedAt
}
