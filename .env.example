# ==========================================
# Database Configuration (Pure PostgreSQL)
# ==========================================
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=ganti_password_db_yang_kuat
POSTGRES_DB=portfolio_db
DATABASE_URL=postgresql://portfolio_user:ganti_password_db_yang_kuat@postgres:5432/portfolio_db?schema=public

# ==========================================
# Admin Portal Credentials (Login ke /admin)
# ==========================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti_password_admin_yang_kuat
SESSION_SECRET=kunci_rahasia_acak_minimal_32_karakter_bebas_untuk_enkripsi_session

# ==========================================
# Deployment Configuration (Portainer & Docker)
# ==========================================
PORT=3032
AUTO_MIGRATE=true

# Ganti dengan username GitHub Anda (huruf kecil semua untuk ghcr.io)
APP_IMAGE=ghcr.io/username-anda/portfolio:latest
